 namespace {
 
+uint32_t DarkelfWebGLDomainHash(const String& hostname) {
+  uint32_t hash = 2166136261u;
+
+  if (hostname.Is8Bit()) {
+    for (LChar ch : hostname.Span8()) {
+      hash ^= static_cast<uint32_t>(ch);
+      hash *= 16777619u;
+    }
+  } else {
+    for (UChar ch : hostname.Span16()) {
+      hash ^= static_cast<uint32_t>(ch);
+      hash *= 16777619u;
+    }
+  }
+
+  return hash;
+}
